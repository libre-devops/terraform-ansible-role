# Runs Ansible roles on hosts from Terraform. Everything Ansible needs is generated into one
# working directory per module call:
#
#   requirements.yml      the roles (and any extra collections) to install
#   playbook.yml          a play that runs the roles in order, after an optional SSH wait play
#   group_vars/all.json   vars and sensitive_vars, at the usual group_vars precedence
#   host_vars/<host>.json how to reach each host, plus host_vars
#   run.sh                what the ansible_playbook resource calls instead of ansible-playbook:
#                         it installs the roles and collections when they are missing or
#                         requirements.yml changed, then runs ansible-playbook
#   roles/, collections/  installed by run.sh, found by Ansible next to the playbook
#
# Installing at run time, rather than in a separate Terraform step, matters in CI: a fresh
# checkout starts with an empty .terraform, Terraform rewrites the generated files without
# counting that as a change, and the roles still have to be there whenever a run happens.
#
# Variables go in group_vars and host_vars rather than extra vars, so roles can still override
# them with set_fact (libre_devops.python sets ansible_python_interpreter that way) and they
# never apply to the control node when a task is delegated to it.
locals {
  work_dir = abspath(coalesce(var.working_directory, "${path.root}/.terraform/ansible/${var.name}"))

  requirements = yamlencode({
    roles = [
      for r in var.roles : { for k, v in {
        name    = r.name
        src     = r.src
        scm     = r.scm
        version = r.version
      } : k => v if v != null }
    ]
    collections = [
      for c in var.collections : { for k, v in {
        name    = c.name
        source  = c.source
        version = c.version
      } : k => v if v != null }
    ]
  })

  wait_play = {
    name         = "Wait for SSH on the ${var.name} hosts"
    hosts        = "all"
    gather_facts = false
    become       = false
    tasks = [{
      name = "Wait until the SSH port answers with an SSH banner"
      "ansible.builtin.wait_for" = {
        host         = "{{ hostvars[inventory_hostname]['ansible_host'] | default(inventory_hostname) }}"
        port         = "{{ hostvars[inventory_hostname]['ansible_port'] | default(22) }}"
        search_regex = "SSH-"
        timeout      = var.wait_timeout
      }
      delegate_to = "localhost"
      when        = "(hostvars[inventory_hostname]['ansible_connection'] | default('ssh')) in ['ssh', 'ansible.builtin.ssh']"
    }]
  }

  roles_play = {
    name         = var.name
    hosts        = "all"
    become       = var.become
    gather_facts = var.gather_facts
    roles        = [for r in var.roles : { role = r.name }]
  }

  # A for expression keeps the two differently shaped plays in one tuple.
  playbook = yamlencode([for i, play in [local.wait_play, local.roles_play] : play if i == 1 || var.wait_for_ssh])

  # A known_hosts file per host and per set of triggers, so a replaced VM that keeps its address
  # starts a new file instead of tripping over the old host key.
  known_hosts = {
    for name, h in var.hosts : name => "${local.work_dir}/known_hosts/${name}-${substr(sha256(jsonencode([h.address, h.port, h.triggers])), 0, 12)}"
  }

  connection_vars = {
    for name, h in var.hosts : name => { for k, v in {
      ansible_host                 = h.address
      ansible_user                 = h.user
      ansible_port                 = h.port
      ansible_connection           = h.connection
      ansible_python_interpreter   = h.python_interpreter
      ansible_ssh_private_key_file = h.private_key_file
      ansible_ssh_common_args      = h.ssh_common_args
      ansible_ssh_extra_args = join(" ", compact([
        h.ssh_extra_args,
        var.ssh_host_key_checking == "accept-new" ? "-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=\"${local.known_hosts[name]}\"" : null,
      ]))
      ansible_host_key_checking = var.ssh_host_key_checking == "no" ? false : null
    } : k => v if v != null && v != "" }
  }

  # Single-quoted for the shell.
  shell_quote = {
    galaxy   = "'${replace(var.ansible_galaxy_binary, "'", "'\\''")}'"
    playbook = "'${replace(var.ansible_playbook_binary, "'", "'\\''")}'"
  }

  wrapper = <<-EOT
    #!/usr/bin/env bash
    # Generated by the libre-devops/role/ansible Terraform module. The ansible_playbook resource
    # calls this instead of ansible-playbook. It installs the roles and collections the first
    # time, and again when requirements.yml changes, then runs ansible-playbook with the same
    # arguments from the same directory, so relative paths in variables work as usual.
    set -euo pipefail
    dir="$(cd "$(dirname "$0")" && pwd)"
    want='${sha256(local.requirements)}'
    galaxy=${local.shell_quote.galaxy}
    playbook=${local.shell_quote.playbook}

    install() {
      rm -rf roles collections .installed
      "$galaxy" role install --force -r requirements.yml -p roles
      ${length(var.collections) > 0 ? "\"$galaxy\" collection install -r requirements.yml -p collections" : "# No extra collections."}
      for f in roles/*/requirements.yml; do
        [ -e "$f" ] || continue
        echo "Collections for $(basename "$(dirname "$f")"), from its requirements.yml"
        "$galaxy" collection install -r "$f" -p collections
      done
      printf '%s\n' "$want" > .installed
    }

    installed() {
      [ "$(cat "$dir/.installed" 2>/dev/null || true)" = "$want" ]
    }

    install_once() {
      if ! installed; then
        echo "Installing the roles and collections in $dir/requirements.yml"
        (cd "$dir" && install)
      fi
    }

    # Terraform runs the hosts in parallel, all through this script: one installs, the rest
    # wait, then find everything in place.
    if ! installed; then
      if command -v flock >/dev/null 2>&1; then
        # The kernel releases the lock when this process ends, even if it is killed.
        exec 9>"$dir/.install.lock"
        if ! flock -w 1800 9; then
          echo "Gave up waiting for the lock on $dir/.install.lock after 30 minutes." >&2
          exit 1
        fi
        install_once
        exec 9>&-
      else
        # No flock (macOS): a lock directory, cleared after 30 minutes if a killed run left it.
        waited=0
        until mkdir "$dir/.install.lock.d" 2>/dev/null; do
          if [ -n "$(find "$dir/.install.lock.d" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then
            rmdir "$dir/.install.lock.d" 2>/dev/null || true
            continue
          fi
          if [ "$waited" -ge 1800 ]; then
            echo "Gave up waiting for $dir/.install.lock.d after 30 minutes." >&2
            exit 1
          fi
          sleep 2
          waited=$((waited + 2))
        done
        trap 'rmdir "$dir/.install.lock.d" 2>/dev/null || true' EXIT
        install_once
        rmdir "$dir/.install.lock.d" 2>/dev/null || true
        trap - EXIT
      fi
    fi

    exec "$playbook" "$@"
  EOT

  # Files written with local_sensitive_file, so only the current user can read them and their
  # contents stay out of plan output.
  var_files = merge(
    { "group_vars/all.json" = jsonencode(merge(var.vars, var.sensitive_vars)) },
    { for name in keys(var.hosts) : "host_vars/${name}.json" => jsonencode(merge(local.connection_vars[name], try(var.host_vars[name], {}))) },
  )

  # Changes to any of these run the roles again on that host (see terraform_data.this).
  run_digest = {
    for name, h in var.hosts : name => sha256(jsonencode({
      requirements = local.requirements
      playbook     = local.playbook
      group_vars   = local.var_files["group_vars/all.json"]
      host_vars    = local.var_files["host_vars/${name}.json"]
      host         = h
      triggers     = var.triggers
      check_mode   = var.check_mode
      tags         = var.tags
    }))
  }
}

resource "local_file" "this" {
  for_each = {
    "requirements.yml"   = { content = local.requirements, mode = "0600" }
    "playbook.yml"       = { content = local.playbook, mode = "0600" }
    "run.sh"             = { content = local.wrapper, mode = "0700" }
    "known_hosts/README" = { content = "Host keys SSH accepted for these hosts, one file per host and set of triggers.\n", mode = "0600" }
  }

  filename             = "${local.work_dir}/${each.key}"
  content              = each.value.content
  file_permission      = each.value.mode
  directory_permission = "0700"
}

resource "local_sensitive_file" "this" {
  for_each = toset(keys(local.var_files))

  filename             = "${local.work_dir}/${each.key}"
  content              = local.var_files[each.key]
  file_permission      = "0600"
  directory_permission = "0700"
}

# One digest per host of everything that should run the roles again. ansible_playbook is
# replaced, not updated, when it changes: the provider saves the new settings even when a run
# in place fails, so the next plan would show nothing to do, whereas a failed create leaves the
# resource tainted and the next apply tries again.
resource "terraform_data" "this" {
  for_each = var.hosts

  input = local.run_digest[each.key]
}

resource "ansible_playbook" "this" {
  for_each = var.hosts

  name                    = each.key
  playbook                = local_file.this["playbook.yml"].filename
  groups                  = each.value.groups
  replayable              = var.run_on_every_apply
  check_mode              = var.check_mode
  diff_mode               = var.diff_mode
  tags                    = var.tags
  verbosity               = var.verbosity
  ansible_playbook_binary = local_file.this["run.sh"].filename

  timeouts {
    create = var.timeout
  }

  lifecycle {
    replace_triggered_by = [terraform_data.this[each.key]]
  }

  depends_on = [local_sensitive_file.this]
}
